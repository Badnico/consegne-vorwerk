{
  "name": "vorwerk-consegne-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestione consegne: proposta data e fascia, risposta Sì/No, riprogrammazione su slot con capienza.",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch --env-file=.env src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx --env-file=.env src/lib/migrate.ts",
    "seed": "tsx --env-file=.env src/lib/seed.ts",
    "demo": "tsx --env-file=.env src/lib/demo.ts",
    "test": "node --env-file-if-exists=.env --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "nodemailer": "^10.0.16",
    "pg": "^8.13.1",
    "pg-boss": "^10.1.6",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
