# Server
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000   # in produzione: https://<tuo-dominio>
TIMEZONE=Europe/Rome

# Database
DATABASE_URL=postgres://consegne:consegne@localhost:5432/consegne

# Operatori (provvisorio: sostituire con login + 2FA o SSO)
ADMIN_API_KEY=cambia-questa-chiave-lunga

# Regole di business
BOOKING_HORIZON_DAYS=14        # giorni prenotabili dal cliente
BOOKING_LEAD_DAYS=1            # preavviso minimo
REMINDER_AFTER_HOURS=24        # sollecito se nessuna risposta
NO_RESPONSE_AFTER_HOURS=48     # poi passa all'operatore
TOKEN_MAX_DAYS=21              # scadenza massima dei link

# WhatsApp Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
WHATSAPP_TEMPLATE_PROPOSAL=consegna_proposta
WHATSAPP_TEMPLATE_LANG=it

# Email (SMTP del provider transazionale)
SMTP_URL=smtp://user:pass@smtp.example.it:587
# Conta solo l'indirizzo: come nome del mittente ogni email usa il nome dell'azienda dell'ambiente
EMAIL_FROM="Consegne <consegne@example.it>"
